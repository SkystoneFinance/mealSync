generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Staff {
  id String @id @default(uuid())

  staffNumber String @unique
  firstName   String
  lastName    String
  department  String

  // Added for first-time activation/login
  phoneNumber String? @unique

  qrCodeId          String  @unique
  qrImage           String
  isActive          Boolean @default(true)
  hasActivedAccount Boolean @default(false)

  // Relations
  user              User?
  attendances       Attendance[]
  selections        MealSelection[]
  weeklySubmissions WeeklySubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id String @id @default(uuid())

  staffId   String
  mealDate  DateTime
  scannedAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([mealDate])
  @@index([scannedAt])
}

model User {
  id String @id @default(uuid())

  // Admins use these
  email    String? @unique
  password String?

  role     Role    @default(USER)
  isActive Boolean @default(true)

  // Staff users are linked here
  staffId String? @unique

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodOption {
  id String @id @default(uuid())

  name  String
  image String

  mealDate DateTime

  isActive Boolean @default(true)

  selections MealSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mealDate])
  @@index([isActive])
}

model MealSelection {
  id String @id @default(uuid())

  staffId      String
  // null when the staff member chose "No meal required" (noMeal = true)
  foodOptionId String?
  noMeal       Boolean  @default(false)
  mealDate     DateTime

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  foodOption FoodOption? @relation(fields: [foodOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One staff = one food selection per day
  @@unique([staffId, mealDate])
  @@index([staffId])
  @@index([foodOptionId])
  @@index([mealDate])
}

// One row per menu week (Mon–Fri). Created when the chef first
// marks closed days or publishes. Dates are UTC midnight (date only).
model MenuWeek {
  id String @id @default(uuid())

  weekStart DateTime @unique // the Monday

  // Days the kitchen is closed that week (no selection needed)
  closedDates DateTime[]

  publishedAt   DateTime?
  publishedById String?

  submissions WeeklySubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staff member's submitted plan for a week. The individual day
// choices live in MealSelection; this records when they submitted.
model WeeklySubmission {
  id String @id @default(uuid())

  staffId    String
  menuWeekId String

  submittedAt DateTime @default(now()) // first submission
  updatedAt   DateTime @updatedAt // last edit

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  menuWeek MenuWeek @relation(fields: [menuWeekId], references: [id], onDelete: Cascade)

  @@unique([staffId, menuWeekId])
  @@index([menuWeekId])
}

// Our own photo of a dish, taken by the chef on the day it's served.
// One per dish name (normalised), reused for every past and future
// FoodOption with that name, whose `image` then points at
// GET /api/v1/dish-photos/:id/image instead of an outside URL.
model DishPhoto {
  id String @id @default(uuid())

  nameKey  String @unique // e.g. "fried rice and chicken"
  mimeType String
  data     Bytes

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
