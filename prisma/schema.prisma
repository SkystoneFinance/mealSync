generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Staff {
  id String @id @default(uuid())

  staffNumber String @unique
  firstName   String
  lastName    String
  department  String

  // Added for first-time activation/login
  phoneNumber String? @unique

  qrCodeId String  @unique
  qrImage  String
  isActive Boolean @default(true)

  // Relations
  user        User?
  attendances Attendance[]
  selections  MealSelection[]
  otps        StaffOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id String @id @default(uuid())

  staffId   String
  mealDate  DateTime
  scannedAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([mealDate])
  @@index([scannedAt])
}

model User {
  id String @id @default(uuid())

  // Admins use these
  email    String? @unique
  password String?

  role     Role    @default(USER)
  isActive Boolean @default(true)

  // Staff users are linked here
  staffId String? @unique

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodOption {
  id String @id @default(uuid())

  name  String
  image String

  mealDate DateTime

  isActive Boolean @default(true)

  selections MealSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mealDate])
  @@index([isActive])
}

model MealSelection {
  id String @id @default(uuid())

  staffId      String
  foodOptionId String
  mealDate     DateTime

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  foodOption FoodOption @relation(fields: [foodOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One staff = one food selection per day
  @@unique([staffId, mealDate])
  @@index([staffId])
  @@index([foodOptionId])
  @@index([mealDate])
}

model StaffOtp {
  id String @id @default(uuid())

  staffId String

  code String

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}
